         <saw:column xsi:type="saw:regularColumn" columnID="rev_arrival">        
            <saw:columnFormula>
               <sawx:expr xsi:type="sawx:sqlExpression">REPORT_SUM("Revenue Details"."Room Revenue" BY "Bookings - Reservation - Details"."Confirmation Number")</sawx:expr></saw:columnFormula>        
            <saw:columnHeading>
               <saw:caption fmt="text">
                  <saw:text>Revenue (Arrival Attribution)</saw:text></saw:caption></saw:columnHeading>      </saw:column>      
         <saw:column xsi:type="saw:regularColumn" columnID="rns_arrival">        
            <saw:columnFormula>
               <sawx:expr xsi:type="sawx:sqlExpression">REPORT_SUM("Room Details"."Room Nights" BY "Bookings - Reservation - Details"."Confirmation Number")</sawx:expr></saw:columnFormula>        
            <saw:columnHeading>
               <saw:caption fmt="text">
                  <saw:text>Nights (Arrival Attribution)</saw:text></saw:caption></saw:columnHeading>      </saw:column>      
         <saw:column xsi:type="saw:regularColumn" columnID="adr_arrival">        
            <saw:columnFormula>          
               <sawx:expr xsi:type="sawx:sqlExpression">            CASE WHEN REPORT_SUM("Room Details"."Room Nights" BY "Bookings - Reservation - Details"."Confirmation Number") &lt;&gt; 0
                 THEN REPORT_SUM("Revenue Details"."Room Revenue" BY "Bookings - Reservation - Details"."Confirmation Number")
                      / REPORT_SUM("Room Details"."Room Nights" BY "Bookings - Reservation - Details"."Confirmation Number")
            END
          </sawx:expr>        </saw:columnFormula>        
            <saw:columnHeading>
               <saw:caption fmt="text">
                  <saw:text>ADR (Arrival Attribution)</saw:text></saw:caption></saw:columnHeading>      </saw:column>      
